# DearMe Web Push backend
#
# Copy this file to `.env` and fill in real values. Never commit `.env` or the
# VAPID private key. Generate a key pair with `npm run generate-vapid`.
PORT=8787

# Comma-separated browser origins allowed to call this API.
# Example: https://dearme.example.com,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# VAPID keys (generate once and keep the private key secret).
VAPID_SUBJECT=mailto:hello@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

DB_PATH=./data/dearme.sqlite
PUSH_TTL_SECONDS=86400
SCHEDULER_INTERVAL_MS=30000
